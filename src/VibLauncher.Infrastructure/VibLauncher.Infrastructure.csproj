<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure is where Core's interfaces meet the outside world: Mojang,
    Modrinth, the loader metadata services, GitHub, the network stack and the
    platform's credential storage. Nothing here is referenced by Core, so the
    domain rules stay testable without any of it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VibLauncher.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibLauncher.Core\VibLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DPAPI, for encrypting account tokens against the current Windows user. Only
      DpapiTokenStore touches it, and only when running on Windows; the Linux and
      macOS builds use the desktop keyring or a machine-bound file instead.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
