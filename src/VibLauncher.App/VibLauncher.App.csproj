<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The launcher itself: an Avalonia desktop application.

    Avalonia rather than WPF because WPF is a Windows-only stack and the launcher
    runs on Linux. The XAML idiom is close enough that the Classic theme carried
    over largely intact, and the same build now produces a working application on
    Linux, Windows and macOS from one set of views. The UI is native XAML
    throughout; nothing here renders HTML or hosts a browser.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VibLauncher.App</RootNamespace>
    <AssemblyName>VibLauncher</AssemblyName>

    <!--
      Avalonia raises unhandled exceptions from its own bindings through the
      normal exception path, and the application handles them. This keeps a
      binding mistake from being silent in a release build.
    -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- The launcher's icon, used for the window and by the desktop entry. -->
    <ApplicationIcon>Assets/viblauncher.ico</ApplicationIcon>

    <!--
      Avalonia's XAML compiler generates the InitializeComponent partials, and
      the analyzers that come with it want this on.
    -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia.Desktop pulls in the X11, Win32 and macOS backends; on Linux the
      X11 one is what runs, under XWayland on a Wayland session.
    -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />

    <!--
      The Fluent theme supplies the templates for the controls the Classic theme
      restyles rather than rebuilds: the text box, the combo box, the scroll bar
      and the tree. Everything with a distinctive shape is retemplated on top of
      it in Themes/Classic.Controls.axaml.
    -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />

    <!-- Binding and layout diagnostics, on F12. Debug builds only. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibLauncher.Core\VibLauncher.Core.csproj" />
    <ProjectReference Include="..\VibLauncher.Infrastructure\VibLauncher.Infrastructure.csproj" />
  </ItemGroup>

</Project>
