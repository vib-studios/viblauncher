<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Vib Studios Classic palette.

        Taken from the compiled Tailwind build behind classic/index.html, where
        the tokens are authored in oklch. Avalonia has no oklch, so each one is
        converted to its sRGB equivalent here and the original is kept in the
        comment so the two can be checked against each other later.
    -->

    <!-- Surfaces: void-950 is the page, void-900 is a card, void-800 is raised. -->
    <Color x:Key="Void950">#FF0E0503</Color>
    <!-- oklch(13% .02 40) -->
    <Color x:Key="Void900">#FF170C09</Color>
    <!-- oklch(17% .02 40) -->
    <Color x:Key="Void800">#FF231814</Color>
    <!-- oklch(22% .02 40) -->

    <!-- The hairline that separates everything on the site. -->
    <Color x:Key="LineColor">#FF281C18</Color>
    <!-- oklch(24% .02 40) -->

    <!-- Ember: the one accent the whole identity rests on. -->
    <Color x:Key="Ember300">#FFFF9960</Color>
    <!-- oklch(80% .16 45) -->
    <Color x:Key="Ember400">#FFFB794A</Color>
    <!-- oklch(72% .17 40) -->
    <Color x:Key="Ember500">#FFE65719</Color>
    <!-- oklch(64% .19 40) -->

    <!-- Text, from headings down to the quietest label. -->
    <Color x:Key="Zinc50">#FFFAFAFA</Color>
    <Color x:Key="Zinc100">#FFF4F4F5</Color>
    <Color x:Key="Zinc200">#FFE4E4E7</Color>
    <Color x:Key="Zinc300">#FFD4D4D8</Color>
    <Color x:Key="Zinc400">#FF9F9FA9</Color>
    <Color x:Key="Zinc500">#FF71717B</Color>
    <Color x:Key="Zinc600">#FF52525C</Color>
    <Color x:Key="Zinc700">#FF3F3F46</Color>
    <Color x:Key="Zinc800">#FF27272A</Color>

    <!-- Status colours. Green and red are the only additions to the site's
         palette, because a launcher has to say "running" and "crashed" and
         ember alone cannot carry both. Both are desaturated to sit alongside it. -->
    <Color x:Key="RunningColor">#FF5FBF7F</Color>
    <Color x:Key="DangerColor">#FFE2564E</Color>
    <Color x:Key="WarningColor">#FFFE9A00</Color>

    <!-- Brushes. Everything in the application binds to these rather than to a
         literal colour, so a future light theme is a matter of swapping this
         dictionary. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Void950}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Void900}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Void800}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />

    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Ember400}" />
    <SolidColorBrush x:Key="EmberHoverBrush" Color="{StaticResource Ember300}" />
    <SolidColorBrush x:Key="EmberPressedBrush" Color="{StaticResource Ember500}" />

    <SolidColorBrush x:Key="HeadingBrush" Color="{StaticResource Zinc50}" />
    <SolidColorBrush x:Key="BodyBrush" Color="{StaticResource Zinc200}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Zinc400}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource Zinc500}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource Zinc600}" />
    <SolidColorBrush x:Key="Zinc700Brush" Color="{StaticResource Zinc700}" />

    <SolidColorBrush x:Key="RunningBrush" Color="{StaticResource RunningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- A 10% ember wash, the site's badge and banner background. -->
    <SolidColorBrush x:Key="EmberWashBrush" Color="{StaticResource Ember500}" Opacity="0.12" />
    <SolidColorBrush x:Key="EmberEdgeBrush" Color="{StaticResource Ember500}" Opacity="0.35" />

    <!--
        The mark.

        These three are deliberately not the Classic ember above. The mark is the
        brand's own three-by-three grid, and the same colours are baked into the
        icon files the desktop draws in the task bar and the window list right
        next to the one the rail draws. They are taken from the site's
        `.mcw-logo__mark` rule so the two cannot drift apart, and they stay put
        even if the Classic palette is retuned.
    -->
    <SolidColorBrush x:Key="MarkEmberBrush" Color="#FFF97316" />
    <SolidColorBrush x:Key="MarkEmberDeepBrush" Color="#FFD9600C" />
    <SolidColorBrush x:Key="MarkVoidBrush" Color="#FF0F0F11" />

    <!--
        Typography.

        The site sets Space Grotesk for prose, JetBrains Mono for labels and
        Press Start 2P for the wordmark. None of the three is guaranteed on any
        desktop, so each family lists the site's choice first and then falls back
        through what a Linux distribution and Windows actually ship. On Arch the
        fallbacks resolve through fontconfig: DejaVu and Liberation come with
        almost every install, and Noto with anything that has a desktop on it.
    -->
    <FontFamily x:Key="SansFont">Space Grotesk, Inter, Noto Sans, DejaVu Sans, Liberation Sans, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Noto Sans Mono, DejaVu Sans Mono, Liberation Mono, Cascadia Mono, Consolas, monospace</FontFamily>
    <FontFamily x:Key="WordmarkFont">Press Start 2P, JetBrains Mono, DejaVu Sans Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <x:Double x:Key="CornerRadiusValue">6</x:Double>

    <!-- The site rounds cards hard and buttons into pills. Cards keep their
         radius here; buttons do not, because a pill button in a desktop
         application reads as a web control rather than a native one. -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>

    <!--
        The card shadow from the site: one tight edge, one wide ambient.

        Avalonia draws these as a Border's BoxShadow rather than as an effect on
        an arbitrary element, which is both cheaper and the only form the GPU
        renderer accelerates.
    -->
    <BoxShadows x:Key="CardShadow">0 6 30 0 #73000000</BoxShadows>

</ResourceDictionary>
