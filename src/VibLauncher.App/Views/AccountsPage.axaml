<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VibLauncher.App.Views.AccountsPage"
             FontFamily="{StaticResource SansFont}">

    <ScrollViewer Padding="26,22,26,22" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Theme="{StaticResource PageTitle}" Text="Accounts" />
            <TextBlock Margin="0,8,0,0"
                       Theme="{StaticResource MutedText}"
                       Text="A Microsoft account signs in through Microsoft's own page and can play on any server. An offline account is a local profile, and only works where the server allows it." />

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button Command="{Binding AddMicrosoftCommand}"
                        Content="Add Microsoft account"
                        Theme="{StaticResource PrimaryButton}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding AddOfflineCommand}"
                        Content="Add offline account"
                        Theme="{StaticResource ClassicButton}" />
            </StackPanel>

            <!-- Said up front, so the Microsoft button is never a dead end. -->
            <Border Margin="0,16,0,0"
                    Padding="14,11"
                    Background="{StaticResource EmberWashBrush}"
                    BorderBrush="{StaticResource EmberEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    IsVisible="{Binding MicrosoftConfigured, Converter={StaticResource InverseBool}}">
                <TextBlock Theme="{StaticResource BodyText}" Text="{Binding MicrosoftHint}" />
            </Border>

            <!--
                Where the credential actually ends up.

                Worth saying on screen rather than only in the log, because the
                answer is not the same on every machine: a desktop with a keyring
                running gets the keyring, and one without gets a file this user
                can read and nobody else can. Someone handing a real Microsoft
                credential to an application is entitled to know which.
            -->
            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <TextBlock Theme="{StaticResource FieldLabel}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="STORAGE" />
                <TextBlock Theme="{StaticResource MonoText}"
                           VerticalAlignment="Center"
                           Text="{Binding TokenStorageText}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel Margin="0,40,0,0" IsVisible="{Binding IsEmpty}">
                <TextBlock Theme="{StaticResource MutedText}" Text="No account selected." />
                <TextBlock Margin="0,6,0,0"
                           Theme="{StaticResource MutedText}"
                           Foreground="{StaticResource FaintBrush}"
                           Text="Minecraft needs a profile to launch with. Add one above." />
            </StackPanel>

            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Theme="{StaticResource Card}" Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HeadingBrush}"
                                                   Text="{Binding Username}" />
                                        <Border Margin="10,0,0,0" Theme="{StaticResource Badge}">
                                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource EmberBrush}"
                                                       Text="{Binding KindLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0"
                                               Theme="{StaticResource MonoText}"
                                               Foreground="{StaticResource FaintBrush}"
                                               Text="{Binding Uuid}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding $parent[ItemsControl].DataContext.SetActiveCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Use this account"
                                            Theme="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Remove"
                                            Theme="{StaticResource DangerButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
