<UserControl x:Class="VibLauncher.App.Views.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource SansFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =========================== Server list =========================== -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,12,16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Servers" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Local vib-MC servers. Separate from your Minecraft instances." />
                    <Button Margin="0,14,0,14"
                            HorizontalAlignment="Left"
                            Command="{Binding CreateCommand}"
                            Content="Create server"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>

                <Grid>
                    <ListBox ItemContainerStyle="{StaticResource ClassicListItem}"
                             ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding Selected}"
                             Style="{StaticResource ClassicListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HeadingBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Subtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="No servers yet."
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource FaintBrush}"
                                   Text="Create one to download vib-MC and run it on this machine."
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================= Detail ============================== -->
        <Grid Grid.Column="1" DataContext="{Binding Detail}">
            <Grid Margin="26,22,26,22"
                  Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title and controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Name}" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                            <TextBlock Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource BodyBrush}"
                                       Text="{Binding StateText}" />
                            <TextBlock Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonoText}"
                                       Text="{Binding AddressText}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding StartCommand}" Content="Start" Style="{StaticResource PrimaryButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding RestartCommand}" Content="Restart" Style="{StaticResource ClassicButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding StopCommand}" Content="Stop" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>

                <!-- A crash is stated, with a route to the log. -->
                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="14,11"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}"
                        Visibility="{Binding HasCrashed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource BodyText}"
                                   Text="{Binding CrashText}" />
                        <Button Margin="14,0,0,0"
                                Command="{Binding OpenLogsCommand}"
                                Content="Open logs"
                                Style="{StaticResource ClassicButton}" />
                    </StackPanel>
                </Border>

                <!-- Stat strip -->
                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="VERSION" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding VersionText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="ADDRESS" />
                            <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding AddressText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="UPTIME" />
                            <TextBlock Style="{StaticResource StatValue}" FontSize="15" Text="{Binding UptimeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MEMORY" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding MemoryText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <TabControl Grid.Row="3" Margin="0,22,0,0" Style="{StaticResource ClassicTabControl}">

                    <!-- ======== Console ======== -->
                    <TabItem Header="Console">
                        <DockPanel>
                            <!-- Command entry, wired to the server's stdin. -->
                            <Border DockPanel.Dock="Bottom"
                                    Margin="0,12,0,0"
                                    Padding="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource ClassicTextBox}"
                                                 Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Command="{Binding SendCommand}" Key="Return" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                MinWidth="80"
                                                Command="{Binding SendCommand}"
                                                Content="Send"
                                                Style="{StaticResource PrimaryButton}" />
                                    </Grid>

                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding QuickCommands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,0"
                                                        Command="{Binding DataContext.QuickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding}"
                                                        Style="{StaticResource ClassicButton}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="4">
                                <ListBox x:Name="ConsoleList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{Binding Console}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="6,1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource BodyBrush}"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </TabItem>

                    <!-- ======== Settings ======== -->
                    <TabItem Header="Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="server.properties" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   Text="Anything not shown here is left exactly as it is in the file. Settings marked as needing a restart only take effect the next time the server binds." />

                                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Properties}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding LabelUpper}" />
                                                            <TextBlock Margin="8,0,0,5"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       Text="RESTART REQUIRED"
                                                                       Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBox Style="{StaticResource ClassicTextBox}"
                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Runtime" />

                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="JAVA RUNTIME" />
                                        <ComboBox ItemsSource="{Binding JavaRuntimes}"
                                                  SelectedItem="{Binding SelectedJava}"
                                                  Style="{StaticResource ClassicComboBox}" />

                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="MAXIMUM MEMORY (MB)" />
                                        <TextBox Style="{StaticResource ClassicTextBox}"
                                                 Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" />

                                        <CheckBox Margin="0,16,0,0"
                                                  Content="Start this server when Vib-launcher opens"
                                                  IsChecked="{Binding AutoStart}"
                                                  Style="{StaticResource ClassicCheckBox}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="vib-MC version" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MonoText}" Text="{Binding UpdateText}" />
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding CheckUpdateCommand}" Content="Check for updates" Style="{StaticResource ClassicButton}" />
                                            <Button Margin="8,0,0,0" Command="{Binding UpdateCommand}" Content="Update" Style="{StaticResource PrimaryButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <Button Command="{Binding SavePropertiesCommand}" Content="Save changes" Style="{StaticResource PrimaryButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Content="Open server folder" Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding OpenWorldCommand}" Content="Open world folder" Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" Content="Open logs" Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="Delete server" Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======== Backups ======== -->
                    <TabItem Header="Backups">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding CreateBackupCommand}" Content="Create backup" Style="{StaticResource PrimaryButton}" />
                                <Button Margin="8,0,0,0" Command="{Binding OpenWorldCommand}" Content="Open world folder" Style="{StaticResource ClassicButton}" />
                            </StackPanel>

                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="Backups are stored outside the server directory, so deleting the server does not delete them."
                                       Visibility="{Binding HasNoBackups, Converter={StaticResource InverseBoolToVisibility}}" />

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="No backups yet. A backup archives this server's worlds, player data, plugins and server.properties."
                                       Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibility}}" />

                            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Backups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="14,11"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlRadius}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource MonoFont}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource HeadingBrush}"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource MonoText}"
                                                               Text="{Binding SizeText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Restore"
                                                            Style="{StaticResource ClassicButton}" />
                                                    <Button Margin="8,0,0,0"
                                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Delete"
                                                            Style="{StaticResource DangerButton}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}"
                       Text="Select a server, or create one to get started."
                       Visibility="{Binding DataContext.HasSelection,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
