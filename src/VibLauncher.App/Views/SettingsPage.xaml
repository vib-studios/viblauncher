<UserControl x:Class="VibLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource SansFont}">

    <ScrollViewer Padding="26,22,26,22" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />

            <!-- ============================ General ============================ -->
            <Border Margin="0,20,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="General" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Ask before deleting an instance, a server or a mod"
                              IsChecked="{Binding ConfirmDeletion}"
                              Style="{StaticResource ClassicCheckBox}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Start Vib-launcher minimised"
                              IsChecked="{Binding StartMinimized}"
                              Style="{StaticResource ClassicCheckBox}" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Show Minecraft snapshots in the version picker"
                              IsChecked="{Binding ShowSnapshots}"
                              Style="{StaticResource ClassicCheckBox}" />
                </StackPanel>
            </Border>

            <!-- =========================== Minecraft =========================== -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Minecraft" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Defaults for newly created instances. Changing them does not touch instances that already exist." />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="DEFAULT JAVA RUNTIME" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding JavaRuntimes}"
                                  SelectedItem="{Binding DefaultJava}"
                                  Style="{StaticResource ClassicComboBox}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshJavaCommand}"
                                Content="Rescan"
                                Style="{StaticResource ClassicButton}" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MonoText}"
                               Foreground="{StaticResource FaintBrush}"
                               Text="{Binding JavaSummary}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT MINIMUM MEMORY (MB)" />
                            <TextBox Style="{StaticResource ClassicTextBox}"
                                     Text="{Binding DefaultMinMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT MAXIMUM MEMORY (MB)" />
                            <TextBox Style="{StaticResource ClassicTextBox}"
                                     Text="{Binding DefaultMaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="DEFAULT JVM ARGUMENTS" />
                    <TextBox AcceptsReturn="True"
                             MinHeight="60"
                             Style="{StaticResource ClassicTextBox}"
                             Text="{Binding DefaultJvmArguments, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- =========================== Downloads =========================== -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Downloads" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="CONCURRENT DOWNLOADS" />
                    <TextBox MaxWidth="120"
                             HorizontalAlignment="Left"
                             Style="{StaticResource ClassicTextBox}"
                             Text="{Binding ConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MonoText}"
                               Foreground="{StaticResource FaintBrush}"
                               Text="A Minecraft install is thousands of small files, so more at once is usually faster." />
                </StackPanel>
            </Border>

            <!-- ============================ Accounts =========================== -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Accounts" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MutedText}"
                               Text="Microsoft sign-in needs an Azure application id. It identifies this build to Microsoft and is not a secret, but it has to belong to whoever ships the launcher, so none is compiled in." />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="AZURE APPLICATION (CLIENT) ID" />
                    <TextBox Style="{StaticResource ClassicTextBox}"
                             Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource FaintBrush}"
                               Text="{Binding MicrosoftStatus}" />
                </StackPanel>
            </Border>

            <!-- ============================ Advanced =========================== -->
            <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Advanced" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Record debug detail in the launcher log"
                              IsChecked="{Binding DebugLogging}"
                              Style="{StaticResource ClassicCheckBox}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="DATA DIRECTORY" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding DataDirectory}" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding OpenDataFolderCommand}" Content="Open data folder" Style="{StaticResource ClassicButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenInstancesFolderCommand}" Content="Instances" Style="{StaticResource ClassicButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenServersFolderCommand}" Content="Servers" Style="{StaticResource ClassicButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenBackupsFolderCommand}" Content="Backups" Style="{StaticResource ClassicButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenLogsFolderCommand}" Content="Launcher logs" Style="{StaticResource ClassicButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Content="Save settings" Style="{StaticResource PrimaryButton}" />
                <Button Margin="8,0,0,0" Command="{Binding ResetCommand}" Content="Reset to defaults" Style="{StaticResource DangerButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
