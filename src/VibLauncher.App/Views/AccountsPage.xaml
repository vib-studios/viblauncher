<UserControl x:Class="VibLauncher.App.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource SansFont}">

    <ScrollViewer Padding="26,22,26,22" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Accounts" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="A Microsoft account signs in through Microsoft's own page and can play on any server. An offline account is a local profile, and only works where the server allows it." />

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button Command="{Binding AddMicrosoftCommand}"
                        Content="Add Microsoft account"
                        Style="{StaticResource PrimaryButton}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding AddOfflineCommand}"
                        Content="Add offline account"
                        Style="{StaticResource ClassicButton}" />
            </StackPanel>

            <!-- Said up front, so the Microsoft button is never a dead end. -->
            <Border Margin="0,16,0,0"
                    Padding="14,11"
                    Background="{StaticResource EmberWashBrush}"
                    BorderBrush="{StaticResource EmberEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    Visibility="{Binding MicrosoftConfigured, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding MicrosoftHint}" />
            </Border>

            <!-- Empty state -->
            <StackPanel Margin="0,40,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource MutedText}" Text="No account selected." />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource MutedText}"
                           Foreground="{StaticResource FaintBrush}"
                           Text="Minecraft needs a profile to launch with. Add one above." />
            </StackPanel>

            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource Card}" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HeadingBrush}"
                                                   Text="{Binding Username}" />
                                        <Border Margin="10,0,0,0" Style="{StaticResource Badge}">
                                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource EmberBrush}"
                                                       Text="{Binding KindLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource FaintBrush}"
                                               Text="{Binding Uuid}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Use this account"
                                            Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Remove"
                                            Style="{StaticResource DangerButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
