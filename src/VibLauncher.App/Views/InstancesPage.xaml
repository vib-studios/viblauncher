<UserControl x:Class="VibLauncher.App.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource SansFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================== Instance list ========================== -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,12,16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Instances" />
                    <StackPanel Margin="0,14,0,14" Orientation="Horizontal">
                        <Button Command="{Binding CreateCommand}"
                                Content="Create"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ImportCommand}"
                                Content="Import"
                                Style="{StaticResource ClassicButton}"
                                ToolTip="A .vibinstance export, a Modrinth .mrpack modpack, or a zip with a Minecraft folder in it." />
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <ListBox ItemContainerStyle="{StaticResource ClassicListItem}"
                             ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding Selected}"
                             Style="{StaticResource ClassicListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HeadingBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Subtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state: says what to do next rather than showing a
                         blank panel. -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="No Minecraft instances yet."
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource FaintBrush}"
                                   Text="Create one to pick a Minecraft version and a mod loader."
                                   TextAlignment="Center" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding CreateCommand}"
                                Content="Create instance"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================= Detail ============================== -->
        <Grid Grid.Column="1" DataContext="{Binding Detail}">
            <ScrollViewer Padding="26,22,26,22"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                <StackPanel>

                    <!-- Title row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Name}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource EmberBrush}"
                                               Text="{Binding MinecraftVersion}" />
                                </Border>
                                <Border Margin="7,0,0,0" Style="{StaticResource Badge}">
                                    <TextBlock FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource EmberBrush}"
                                               Text="{Binding LoaderText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding StopCommand}"
                                    Content="Stop"
                                    Style="{StaticResource DangerButton}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding PlayCommand}"
                                    Content="{Binding PlayButtonText}"
                                    Style="{StaticResource PlayButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- Stat strip -->
                    <Border Margin="0,20,0,0" Style="{StaticResource Card}">
                        <Grid>
                            <!-- The status column carries a sentence rather than a
                                 number, so it gets the room the four figures do not
                                 need. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="2.1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINECRAFT" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding MinecraftVersion}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MODS" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ModCountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MEMORY" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding MemoryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ACCOUNT" />
                                <TextBlock Style="{StaticResource StatValue}"
                                           FontSize="13.5"
                                           Text="{Binding AccountText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AccountText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS" />
                                <TextBlock Style="{StaticResource StatValue}"
                                           FontSize="13.5"
                                           Text="{Binding InstallStateText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row actions -->
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Button Command="{Binding PrepareCommand}"
                                Content="Prepare files"
                                Style="{StaticResource ClassicButton}"
                                ToolTip="Download the Minecraft files this instance needs, without launching it." />
                        <Button Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Content="Open folder" Style="{StaticResource ClassicButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding RenameCommand}" Content="Rename" Style="{StaticResource ClassicButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding DuplicateCommand}" Content="Duplicate" Style="{StaticResource ClassicButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" Content="Export" Style="{StaticResource ClassicButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="Delete" Style="{StaticResource DangerButton}" />
                    </StackPanel>

                    <!-- ============================ Tabs ============================ -->
                    <TabControl Margin="0,26,0,0" Style="{StaticResource ClassicTabControl}">

                        <!-- ======== Mods ======== -->
                        <TabItem Header="Mods">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SupportsMods, Converter={StaticResource BoolToVisibility}}">
                                    <Button Command="{Binding BrowseModsCommand}" Content="Browse mods" Style="{StaticResource PrimaryButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding InstallModFileCommand}" Content="Install from file" Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding CheckModUpdatesCommand}" Content="Check for updates" Style="{StaticResource ClassicButton}" />
                                    <Button Margin="8,0,0,0" Command="{Binding OpenModsFolderCommand}" Content="Open mods folder" Style="{StaticResource ClassicButton}" />
                                </StackPanel>

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource MutedText}"
                                           Text="{Binding ModsEmptyText}"
                                           Visibility="{Binding HasNoMods, Converter={StaticResource BoolToVisibility}}" />

                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Mods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="14,11"
                                                    Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource ControlRadius}"
                                                    Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacity}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource HeadingBrush}"
                                                                       Text="{Binding Name}" />
                                                            <Border Margin="8,0,0,0"
                                                                    Style="{StaticResource Badge}"
                                                                    Visibility="{Binding AvailableUpdate, Converter={StaticResource NotNullToVisibility}}">
                                                                <TextBlock FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource EmberBrush}"
                                                                           Text="update available" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Text="{Binding Subtitle}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Update"
                                                                Style="{StaticResource ClassicButton}"
                                                                Visibility="{Binding AvailableUpdate, Converter={StaticResource NotNullToVisibility}}" />
                                                        <Button Margin="8,0,0,0"
                                                                Command="{Binding DataContext.OpenModPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="View source"
                                                                Style="{StaticResource LinkButton}"
                                                                Visibility="{Binding PageUrl, Converter={StaticResource NotNullToVisibility}}" />
                                                        <Button Margin="8,0,0,0"
                                                                Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding IsEnabled, Converter={StaticResource BoolToToggleText}}"
                                                                Style="{StaticResource ClassicButton}" />
                                                        <Button Margin="8,0,0,0"
                                                                Command="{Binding DataContext.RemoveModCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Remove"
                                                                Style="{StaticResource DangerButton}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </TabItem>

                        <!-- ======== Settings ======== -->
                        <TabItem Header="Settings">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Version" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource MutedText}"
                                                   Text="Changing the Minecraft version or the mod loader keeps the instance's mods, configuration and worlds in place." />
                                        <Button Margin="0,14,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding ChangeVersionCommand}"
                                                Content="Change version or loader"
                                                Style="{StaticResource ClassicButton}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Java and memory" />

                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="JAVA RUNTIME" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding JavaRuntimes}"
                                                      SelectedItem="{Binding SelectedJava}"
                                                      Style="{StaticResource ClassicComboBox}" />
                                            <Button Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding BrowseJavaCommand}"
                                                    Content="Browse"
                                                    Style="{StaticResource ClassicButton}" />
                                        </Grid>
                                        <TextBlock Margin="0,7,0,0"
                                                   Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   Text="{Binding RequiredJavaText}" />

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIMUM MEMORY (MB)" />
                                                <TextBox Style="{StaticResource ClassicTextBox}"
                                                         Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM MEMORY (MB)" />
                                                <TextBox Style="{StaticResource ClassicTextBox}"
                                                         Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="JVM ARGUMENTS" />
                                        <TextBox AcceptsReturn="True"
                                                 MinHeight="62"
                                                 Style="{StaticResource ClassicTextBox}"
                                                 Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />

                                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="NOTES" />
                                        <TextBox AcceptsReturn="True"
                                                 MinHeight="56"
                                                 Style="{StaticResource ClassicTextBox}"
                                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />

                                        <Button Margin="0,18,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding SaveSettingsCommand}"
                                                Content="Save changes"
                                                Style="{StaticResource PrimaryButton}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Folders" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Margin="0,0,8,8" Command="{Binding OpenSavesFolderCommand}" Content="Saves" Style="{StaticResource ClassicButton}" />
                                            <Button Margin="0,0,8,8" Command="{Binding OpenResourcePacksCommand}" Content="Resource packs" Style="{StaticResource ClassicButton}" />
                                            <Button Margin="0,0,8,8" Command="{Binding OpenShaderPacksCommand}" Content="Shader packs" Style="{StaticResource ClassicButton}" />
                                            <Button Margin="0,0,8,8" Command="{Binding OpenScreenshotsCommand}" Content="Screenshots" Style="{StaticResource ClassicButton}" />
                                            <Button Margin="0,0,8,8" Command="{Binding OpenLogsFolderCommand}" Content="Logs" Style="{StaticResource ClassicButton}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ======== Logs ======== -->
                        <TabItem Header="Logs">
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ListBox MaxHeight="420"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{Binding LogLines}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="6,1" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Nothing selected: only reachable when the list is empty. -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}"
                       Text="Select an instance, or create one to get started."
                       Visibility="{Binding DataContext.HasSelection,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
