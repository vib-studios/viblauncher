<UserControl x:Class="VibLauncher.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource SansFont}">

    <DockPanel Margin="26,22,26,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Downloads" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="{Binding Summary}" />

            <StackPanel Margin="0,16,0,16" Orientation="Horizontal">
                <Button Command="{Binding CancelAllCommand}" Content="Cancel all" Style="{StaticResource ClassicButton}" />
                <Button Margin="8,0,0,0" Command="{Binding ClearFinishedCommand}" Content="Clear finished" Style="{StaticResource ClassicButton}" />
                <Button Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Content="Open downloads folder" Style="{StaticResource ClassicButton}" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Style="{StaticResource MutedText}"
                       Foreground="{StaticResource FaintBrush}"
                       Text="Minecraft files, mod loaders, mods and server jars all appear here as they are fetched."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListBox Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Items}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="14,11"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock FontFamily="{StaticResource MonoFont}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource HeadingBrush}"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource FaintBrush}"
                                               Text="{Binding Category}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource MonoText}"
                                               Text="{Binding ProgressText}" />
                                    <Button Margin="10,0,0,0"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Retry"
                                            Style="{StaticResource LinkButton}" />
                                    <Button Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Cancel"
                                            Style="{StaticResource LinkButton}" />
                                </StackPanel>

                                <ProgressBar Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="2"
                                             Margin="0,10,0,0"
                                             IsIndeterminate="{Binding IsIndeterminate}"
                                             Maximum="1"
                                             Style="{StaticResource ClassicProgressBar}"
                                             Value="{Binding Progress, Mode=OneWay}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Margin="0,10,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource DangerBrush}"
                                           Style="{StaticResource BodyText}"
                                           Text="{Binding Error}"
                                           Visibility="{Binding Error, Converter={StaticResource NotNullToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
