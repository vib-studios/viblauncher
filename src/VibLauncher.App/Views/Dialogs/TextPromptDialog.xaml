<Window x:Class="VibLauncher.App.Views.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vib-launcher"
        Width="430"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="Headline" Style="{StaticResource SectionTitle}" Text="Name" />

            <TextBlock x:Name="Hint"
                       Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text=""
                       Visibility="Collapsed" />

            <TextBlock x:Name="FieldName"
                       Margin="0,16,0,0"
                       Style="{StaticResource FieldLabel}"
                       Text="NAME" />
            <TextBox x:Name="Input"
                     KeyDown="OnInputKeyDown"
                     Style="{StaticResource ClassicTextBox}" />

            <TextBlock x:Name="Error"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{StaticResource DangerBrush}"
                       Style="{StaticResource BodyText}"
                       Text=""
                       Visibility="Collapsed" />

            <StackPanel Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="96"
                        Click="OnCancel"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource ClassicButton}" />
                <Button MinWidth="96"
                        Click="OnConfirm"
                        Content="Save"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        x:Name="ConfirmButton" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
