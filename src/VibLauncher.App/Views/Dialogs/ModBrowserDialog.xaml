<Window x:Class="VibLauncher.App.Views.Dialogs.ModBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vib-launcher"
        Width="940"
        Height="640"
        MinWidth="820"
        MinHeight="520"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what is being searched, and for which instance. -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Browse mods" />
            <TextBlock x:Name="Context"
                       Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="" />
        </StackPanel>

        <!-- Search row -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     KeyDown="OnSearchKeyDown"
                     Style="{StaticResource ClassicTextBox}" />

            <ComboBox x:Name="SortBox"
                      Grid.Column="1"
                      Width="150"
                      Margin="10,0,0,0"
                      SelectionChanged="OnSortChanged"
                      Style="{StaticResource ClassicComboBox}" />

            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    MinWidth="96"
                    Click="OnSearch"
                    Content="Search"
                    Style="{StaticResource ClassicButton}" />
        </Grid>

        <!-- Results on the left, the selected mod's detail on the right. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="Results"
                             ItemContainerStyle="{StaticResource ClassicListItem}"
                             SelectionChanged="OnResultSelected"
                             Style="{StaticResource ClassicListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HeadingBrush}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   MaxHeight="34"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Top"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource FaintBrush}"
                                               Text="{Binding DownloadsText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ResultsEmpty"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Text="Searching"
                               TextAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <TextBlock x:Name="DetailName" Style="{StaticResource SectionTitle}" Text="" />
                        <TextBlock x:Name="DetailAuthor"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource MonoText}"
                                   Text="" />

                        <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="RELEASE" />
                        <ComboBox x:Name="VersionBox"
                                  MaxDropDownHeight="240"
                                  SelectionChanged="OnVersionChanged"
                                  Style="{StaticResource ClassicComboBox}" />

                        <TextBlock x:Name="CompatibilityText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MonoText}"
                                   Text=""
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="DependencyPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="REQUIRED ALONGSIDE" />
                            <ItemsControl x:Name="Dependencies">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BodyBrush}"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="ABOUT" />
                        <TextBlock x:Name="DetailDescription"
                                   MaxHeight="220"
                                   Style="{StaticResource BodyText}"
                                   Text="" />

                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Click="OnOpenPage"
                                Content="Open project page"
                                Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ProviderNote"
                       VerticalAlignment="Center"
                       Style="{StaticResource MonoText}"
                       Foreground="{StaticResource FaintBrush}"
                       Text="" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="100"
                        Click="OnClose"
                        Content="Close"
                        IsCancel="True"
                        Style="{StaticResource ClassicButton}" />
                <Button x:Name="InstallButton"
                        MinWidth="120"
                        Click="OnInstall"
                        Content="Install"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
