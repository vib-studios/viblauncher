<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VibLauncher.App.Views.Dialogs.CreateServerDialog"
        Title="Vib-launcher"
        Width="520"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="26">
        <StackPanel>
            <TextBlock Theme="{StaticResource PageTitle}" Text="Create vib-MC server" />
            <TextBlock Margin="0,8,0,0"
                       Theme="{StaticResource MutedText}"
                       Text="The server jar comes from the vib-MC project's own releases. It runs as its own Java process, separate from the launcher." />

            <TextBlock Margin="0,22,0,0" Theme="{StaticResource FieldLabel}" Text="NAME" />
            <TextBox x:Name="NameBox" Theme="{StaticResource ClassicTextBox}" Text="My survival server" />

            <Grid Margin="0,18,0,0" ColumnDefinitions="*,14,*">
                <StackPanel>
                    <TextBlock Theme="{StaticResource FieldLabel}" Text="PORT" />
                    <TextBox x:Name="PortBox"
                             LostFocus="OnPortChanged"
                             Theme="{StaticResource ClassicTextBox}"
                             Text="25565" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Theme="{StaticResource FieldLabel}" Text="MAXIMUM MEMORY (MB)" />
                    <TextBox x:Name="MemoryBox" Theme="{StaticResource ClassicTextBox}" Text="4096" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,18,0,0" Theme="{StaticResource FieldLabel}" Text="VIB-MC RELEASE" />
            <ComboBox x:Name="ReleaseBox"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="260"
                      Theme="{StaticResource ClassicComboBox}" />

            <TextBlock Margin="0,18,0,0" Theme="{StaticResource FieldLabel}" Text="JAVA RUNTIME" />
            <ComboBox x:Name="JavaBox" HorizontalAlignment="Stretch" Theme="{StaticResource ClassicComboBox}" />
            <TextBlock x:Name="JavaNote"
                       Margin="0,7,0,0"
                       Theme="{StaticResource MonoText}"
                       Foreground="{StaticResource FaintBrush}"
                       Text="vib-MC runs on Java 8 or newer." />

            <Border x:Name="NoticePanel"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{StaticResource EmberWashBrush}"
                    BorderBrush="{StaticResource EmberEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    IsVisible="False">
                <StackPanel>
                    <TextBlock x:Name="NoticeText"
                               FontSize="12"
                               Foreground="{StaticResource BodyBrush}"
                               Theme="{StaticResource BodyText}"
                               Text="" />
                    <Button x:Name="UseSuggestedPort"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="OnUseSuggestedPort"
                            Content="Use that port"
                            Theme="{StaticResource ClassicButton}"
                            IsVisible="False" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="100"
                        Click="OnCancel"
                        Content="Cancel"
                        IsCancel="True"
                        Theme="{StaticResource ClassicButton}" />
                <Button x:Name="ConfirmButton"
                        MinWidth="130"
                        Click="OnConfirm"
                        Content="Create server"
                        IsDefault="True"
                        Theme="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
