<Window x:Class="VibLauncher.App.Views.Dialogs.DeviceCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vib-launcher"
        Width="500"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Sign in with Microsoft" />

            <!-- The whole point of the device-code flow: the password is typed on
                 Microsoft's page, never here. The dialog says so explicitly. -->
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Vib-launcher never asks for your Microsoft password. Open the page below, enter the code, and sign in with Microsoft directly." />

            <Border Margin="0,20,0,0" Style="{StaticResource Card}">
                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="OPEN THIS PAGE" />
                    <TextBlock x:Name="UrlText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               Text="" />

                    <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="AND ENTER THIS CODE" />
                    <TextBox x:Name="CodeText"
                             FontSize="22"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             Style="{StaticResource ClassicTextBox}"
                             Text="" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Click="OnOpenPage" Content="Open the page" Style="{StaticResource PrimaryButton}" />
                        <Button Margin="8,0,0,0" Click="OnCopyCode" Content="Copy code" Style="{StaticResource ClassicButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <ProgressBar Width="120"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Style="{StaticResource ClassicProgressBar}" />
                <TextBlock x:Name="StatusText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource MonoText}"
                           Text="Asking Microsoft for a code" />
            </StackPanel>

            <Button Margin="0,22,0,0"
                    MinWidth="100"
                    HorizontalAlignment="Right"
                    Click="OnCancel"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource ClassicButton}" />
        </StackPanel>
    </Border>
</Window>
