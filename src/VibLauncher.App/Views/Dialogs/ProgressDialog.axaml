<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VibLauncher.App.Views.Dialogs.ProgressDialog"
        Title="Vib-launcher"
        Width="470"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="Headline"
                       Theme="{StaticResource SectionTitle}"
                       Text="Working" />

            <!-- The status line is replaced as each phase reports in, so the
                 dialog says what is actually happening rather than spinning. -->
            <TextBlock x:Name="Status"
                       Margin="0,10,0,0"
                       MinHeight="38"
                       Theme="{StaticResource MonoText}"
                       Text="Starting"
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="Bar"
                         Margin="0,14,0,0"
                         IsIndeterminate="True"
                         Theme="{StaticResource ClassicProgressBar}" />

            <Button x:Name="CancelButton"
                    Margin="0,22,0,0"
                    MinWidth="96"
                    HorizontalAlignment="Right"
                    Click="OnCancel"
                    Content="Cancel"
                    Theme="{StaticResource ClassicButton}" />
        </StackPanel>
    </Border>
</Window>
