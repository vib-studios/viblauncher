<Window x:Class="VibLauncher.App.Views.Dialogs.ExportInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibLauncher.App.ViewModels"
        Title="Vib-launcher"
        Width="620"
        Height="600"
        MinWidth="520"
        MinHeight="440"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- One row: the tick, the name, and what it costs the archive. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:ExportEntryViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Two-state on purpose: the half-tick is something the picker
                     works out, never something a click asks for. -->
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                          IsThreeState="False"
                          Style="{StaticResource ClassicCheckBox}" />

                <TextBlock Grid.Column="1"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyText}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Text="{Binding Detail}" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Headline" Style="{StaticResource SectionTitle}" Text="Export instance" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Untick anything that should stay behind. Minecraft's own assets, libraries and versions are never included: they are downloaded again on import." />
        </StackPanel>

        <!-- Bulk actions sit above the tree, where they read as acting on it. -->
        <StackPanel Grid.Row="1"
                    Margin="0,18,0,10"
                    Orientation="Horizontal">
            <Button MinWidth="96"
                    Click="OnSelectAll"
                    Content="Select all"
                    Style="{StaticResource ClassicButton}" />
            <Button Margin="10,0,0,0"
                    MinWidth="96"
                    Click="OnSelectNone"
                    Content="Select none"
                    Style="{StaticResource ClassicButton}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="10,8" Style="{StaticResource Card}">
            <Grid>
                <TreeView x:Name="Contents"
                          ItemsSource="{Binding Entries}"
                          Style="{StaticResource ClassicTreeView}" />

                <TextBlock x:Name="EmptyNotice"
                           Margin="8,10,8,0"
                           VerticalAlignment="Top"
                           Style="{StaticResource MutedText}"
                           Text="There is nothing here yet. An export would carry only the instance's settings."
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}"
                       Text="{Binding Summary}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="96"
                        Click="OnCancel"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource ClassicButton}" />
                <Button MinWidth="120"
                        Click="OnConfirm"
                        Content="Choose file"
                        IsDefault="True"
                        IsEnabled="{Binding CanExport}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
