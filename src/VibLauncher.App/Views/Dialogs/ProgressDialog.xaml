<Window x:Class="VibLauncher.App.Views.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vib-launcher"
        Width="470"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="Headline"
                       Style="{StaticResource SectionTitle}"
                       Text="Working" />

            <!-- The status line is replaced as each phase reports in, so the
                 dialog says what is actually happening rather than spinning. -->
            <TextBlock x:Name="Status"
                       Margin="0,10,0,0"
                       MinHeight="38"
                       Style="{StaticResource MonoText}"
                       Text="Starting"
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="Bar"
                         Margin="0,14,0,0"
                         IsIndeterminate="True"
                         Style="{StaticResource ClassicProgressBar}" />

            <Button x:Name="CancelButton"
                    Margin="0,22,0,0"
                    MinWidth="96"
                    HorizontalAlignment="Right"
                    Click="OnCancel"
                    Content="Cancel"
                    Style="{StaticResource ClassicButton}" />
        </StackPanel>
    </Border>
</Window>
