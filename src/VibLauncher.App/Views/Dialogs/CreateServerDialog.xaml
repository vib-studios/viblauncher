<Window x:Class="VibLauncher.App.Views.Dialogs.CreateServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vib-launcher"
        Width="520"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Border Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Create vib-MC server" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="The server jar comes from the vib-MC project's own releases. It runs as its own Java process, separate from the launcher." />

            <TextBlock Margin="0,22,0,0" Style="{StaticResource FieldLabel}" Text="NAME" />
            <TextBox x:Name="NameBox" Style="{StaticResource ClassicTextBox}" Text="My survival server" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PORT" />
                    <TextBox x:Name="PortBox"
                             LostFocus="OnPortChanged"
                             Style="{StaticResource ClassicTextBox}"
                             Text="25565" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM MEMORY (MB)" />
                    <TextBox x:Name="MemoryBox" Style="{StaticResource ClassicTextBox}" Text="4096" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="VIB-MC RELEASE" />
            <ComboBox x:Name="ReleaseBox"
                      MaxDropDownHeight="260"
                      Style="{StaticResource ClassicComboBox}" />

            <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="JAVA RUNTIME" />
            <ComboBox x:Name="JavaBox" Style="{StaticResource ClassicComboBox}" />
            <TextBlock x:Name="JavaNote"
                       Margin="0,7,0,0"
                       Style="{StaticResource MonoText}"
                       Foreground="{StaticResource FaintBrush}"
                       Text="vib-MC runs on Java 8 or newer." />

            <Border x:Name="NoticePanel"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{StaticResource EmberWashBrush}"
                    BorderBrush="{StaticResource EmberEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlRadius}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="NoticeText"
                               FontSize="12"
                               Foreground="{StaticResource BodyBrush}"
                               Style="{StaticResource BodyText}"
                               Text="" />
                    <Button x:Name="UseSuggestedPort"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="OnUseSuggestedPort"
                            Content="Use that port"
                            Style="{StaticResource ClassicButton}"
                            Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="100"
                        Click="OnCancel"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource ClassicButton}" />
                <Button x:Name="ConfirmButton"
                        MinWidth="130"
                        Click="OnConfirm"
                        Content="Create server"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
