<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VibLauncher.App.Views.Dialogs.ModBrowserDialog"
        Title="Vib-launcher"
        Width="940"
        Height="640"
        MinWidth="820"
        MinHeight="520"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource SansFont}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: what is being searched, and for which instance. -->
        <StackPanel Grid.Row="0">
            <TextBlock Theme="{StaticResource PageTitle}" Text="Browse mods" />
            <TextBlock x:Name="Context"
                       Margin="0,8,0,0"
                       Theme="{StaticResource MutedText}"
                       Text="" />
        </StackPanel>

        <!-- Search row -->
        <Grid Grid.Row="1" Margin="0,20,0,16" ColumnDefinitions="*,Auto,Auto">

            <TextBox x:Name="SearchBox"
                     KeyDown="OnSearchKeyDown"
                     Theme="{StaticResource ClassicTextBox}" />

            <ComboBox x:Name="SortBox"
                      Grid.Column="1"
                      Width="150"
                      Margin="10,0,0,0"
                      SelectionChanged="OnSortChanged"
                      Theme="{StaticResource ClassicComboBox}" />

            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    MinWidth="96"
                    Click="OnSearch"
                    Content="Search"
                    Theme="{StaticResource ClassicButton}" />
        </Grid>

        <!-- Results on the left, the selected mod's detail on the right. -->
        <Grid Grid.Row="2" ColumnDefinitions="1.15*,14,*">

            <Border Theme="{StaticResource Card}" Padding="8">
                <Panel>
                    <ListBox x:Name="Results"
                             ItemContainerTheme="{StaticResource ClassicListItem}"
                             SelectionChanged="OnResultSelected"
                             Theme="{StaticResource ClassicListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HeadingBrush}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   MaxHeight="34"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Top"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource FaintBrush}"
                                               Text="{Binding DownloadsText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ResultsEmpty"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Theme="{StaticResource MutedText}"
                               Text="Searching"
                               TextAlignment="Center" />
                </Panel>
            </Border>

            <Border Grid.Column="2" Theme="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" IsVisible="False">
                        <TextBlock x:Name="DetailName" Theme="{StaticResource SectionTitle}" Text="" />
                        <TextBlock x:Name="DetailAuthor"
                                   Margin="0,6,0,0"
                                   Theme="{StaticResource MonoText}"
                                   Text="" />

                        <TextBlock Margin="0,18,0,0" Theme="{StaticResource FieldLabel}" Text="RELEASE" />
                        <ComboBox x:Name="VersionBox"
                                  HorizontalAlignment="Stretch"
                                  MaxDropDownHeight="240"
                                  SelectionChanged="OnVersionChanged"
                                  Theme="{StaticResource ClassicComboBox}" />

                        <TextBlock x:Name="CompatibilityText"
                                   Margin="0,10,0,0"
                                   Theme="{StaticResource MonoText}"
                                   Text=""
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="DependencyPanel" Margin="0,18,0,0" IsVisible="False">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="REQUIRED ALONGSIDE" />
                            <ItemsControl x:Name="Dependencies">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BodyBrush}"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" Theme="{StaticResource FieldLabel}" Text="ABOUT" />
                        <TextBlock x:Name="DetailDescription"
                                   MaxHeight="220"
                                   Theme="{StaticResource BodyText}"
                                   Text="" />

                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Click="OnOpenPage"
                                Content="Open project page"
                                Theme="{StaticResource LinkButton}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ProviderNote"
                       VerticalAlignment="Center"
                       Theme="{StaticResource MonoText}"
                       Foreground="{StaticResource FaintBrush}"
                       Text="" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        MinWidth="100"
                        Click="OnClose"
                        Content="Close"
                        IsCancel="True"
                        Theme="{StaticResource ClassicButton}" />
                <Button x:Name="InstallButton"
                        MinWidth="120"
                        Click="OnInstall"
                        Content="Install"
                        IsEnabled="False"
                        Theme="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
