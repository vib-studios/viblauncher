<Project>

  <!--
    Shared build settings for every Vib-launcher project.

    Warnings are errors: the launcher shells out to Java, writes into user
    directories and handles auth tokens, so a nullable warning here is a real
    bug waiting to happen at runtime.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Globalization data is required, not optional. Published with
      InvariantGlobalization=true the launcher does not start: the process comes
      up and stays alive, but no window is ever created and nothing is written
      to the console, so there is no error to work back from. Culture-sensitive
      formatting in the launcher itself is explicit about which culture it uses.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Vib-launcher</Product>
    <Company>Vib Studios</Company>
    <Copyright>Copyright (C) 2026 Vib Studios. Licensed GPL-3.0-or-later.</Copyright>
    <Version>0.2.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
