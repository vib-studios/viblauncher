# Maintainer: Vib Studios

# The database name is suffixed with the architecture so a repository can hold an
# x86_64 build and an aarch64 build at the same pkgver. repo-add indexes a
# package by name and version, so with an unsuffixed name both builds claim
# viblauncher at $pkgver-$pkgrel and adding the second removes the first
# ("Removing existing entry"), leaving a multi-arch repository carrying one
# architecture and pacman finding nothing to install on the other.
pkgname=viblauncher-$arch
pkgver=0.2.0
pkgrel=1
pkgdesc='Minecraft launcher for instances, mods and vib-MC servers'
arch=('x86_64' 'aarch64')
url='https://github.com/vib-studios/viblauncher'
license=('GPL-3.0-or-later')

# The files themselves are not suffixed. The command is `viblauncher` on every
# architecture, and _app is the unsuffixed name used for the install paths, the
# desktop entry and the icon names, so nothing user-facing changes and the
# wrapper keeps the name a user would type. _app is underscore-prefixed, as the
# packaging guidelines require of any variable makepkg does not define itself.
_app=viblauncher

# The launcher shells out to Java to run Minecraft, so a JRE is a hard runtime
# dependency rather than a suggestion. 17 is the floor for anything from
# Minecraft 1.18 on; older versions need an older runtime, which the launcher
# finds by itself under /usr/lib/jvm if one is installed alongside.
depends=(
  'dotnet-runtime-10.0'
  'java-runtime>=17'
  # The X11 backend's rendering and text stack.
  'fontconfig'
  'libx11'
  'libice'
  'libsm'
)

optdepends=(
  'libsecret: store Microsoft account tokens in the desktop keyring'
  'gnome-keyring: a Secret Service provider for libsecret'
  'kwallet: an alternative Secret Service provider'
  'xdg-utils: open folders and links in the desktop file manager and browser'
  'xdg-desktop-portal: native file pickers under Wayland and Flatpak'
)

makedepends=('dotnet-sdk-10.0' 'git')

# Named explicitly so the checkout lands in $srcdir/$_app regardless of what the
# repository itself is called; build(), check() and package() all cd there.
# $_app rather than $pkgname: pkgname now carries -$arch, and the clone is the
# same working tree for both architectures.
source=("$_app::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

_project=VibLauncher

build() {
  cd "$srcdir/$_app"

  # Telemetry off and no first-run banner: a package build must not phone home
  # or write into the builder's home directory.
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

  local rid
  case "$CARCH" in
    x86_64)  rid=linux-x64 ;;
    aarch64) rid=linux-arm64 ;;
    *) echo "unsupported architecture: $CARCH" >&2; return 1 ;;
  esac

  # Framework-dependent on purpose: dotnet-runtime-10.0 is a dependency, so the
  # package does not ship a second copy of the runtime for every application
  # that uses it. --no-self-contained is what keeps that true while still
  # producing a native launcher binary for the RID.
  # DebugType=none keeps the .pdb files out of the package and stops the
  # assemblies embedding the absolute path they were built at, which makepkg
  # reports as a reference to $srcdir.
  dotnet publish src/$_project.App/$_project.App.csproj \
    --configuration Release \
    --runtime "$rid" \
    --no-self-contained \
    -p:DebugType=none \
    -p:DebugSymbols=false \
    --output "$srcdir/publish"
}

check() {
  cd "$srcdir/$_app"

  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1

  # The suite runs without a network and without a display: the download tests
  # stand up a loopback server, and nothing here opens a window.
  dotnet test tests/$_project.Tests/$_project.Tests.csproj --configuration Release
}

package() {
  # Paths use $_app, not $pkgname: the installed files are not architecture
  # suffixed, so /usr/bin/viblauncher and the desktop entry are the same on every
  # architecture and a user upgrading between them replaces the same paths.
  #
  # The application and everything it loads go in one directory, with a wrapper
  # on PATH. A .NET application's files are not individually useful and do not
  # belong loose in /usr/lib.
  install -dm755 "$pkgdir/usr/lib/$_app"
  cp -r "$srcdir/publish/." "$pkgdir/usr/lib/$_app/"

  # Everything readable, only the entry point executable.
  chmod -R u=rwX,go=rX "$pkgdir/usr/lib/$_app"
  chmod 755 "$pkgdir/usr/lib/$_app/$_project"

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$_app/$_project" "$pkgdir/usr/bin/$_app"

  cd "$srcdir/$_app"

  install -Dm644 "packaging/linux/$_app.desktop" \
    "$pkgdir/usr/share/applications/$_app.desktop"

  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/linux/icons/$_app-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_app.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_app/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_app/README.md"
}
