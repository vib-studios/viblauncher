<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the launcher's rules. Everything here runs without a network and
    without a UI: the download tests stand up a loopback HTTP server, and the
    rest work against a temporary data directory.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VibLauncher.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xunit's analyzers are noisier than they are useful here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibLauncher.Core\VibLauncher.Core.csproj" />
    <ProjectReference Include="..\..\src\VibLauncher.Infrastructure\VibLauncher.Infrastructure.csproj" />
  </ItemGroup>

</Project>
